# NAHIDA Backend Environment Configuration
PORT=8000
HOST=0.0.0.0

# Mock Telemetry Switch (true = generate realistic mock telemetry, false = use real ESP32 sensors)
MOCK_TELEMETRY=true
MOCK_INTERVAL_SECONDS=3.0

# Database URL (PostgreSQL / TimescaleDB)
# Falls back to in-memory store if database is offline
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nahida_db
DB_CONNECT_TIMEOUT=2

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
