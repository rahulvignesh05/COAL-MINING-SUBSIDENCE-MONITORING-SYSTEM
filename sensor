"""
ESP32 Sensor Telemetry Preprocessing & Normalization Engine
Smart Mine — Subsidence Sentinel
"""

import math
from datetime import datetime
from typing import Dict, Any, Tuple, List, Optional


def standardize_zone(zone_raw: Any) -> str:
    """Standardizes zone identifiers to ZONE-A, ZONE-B, ZONE-C format."""
    if not zone_raw:
        return "ZONE-B"
    z = str(zone_raw).strip().upper()
    if "A" in z:
        return "ZONE-A"
    if "C" in z:
        return "ZONE-C"
    return "ZONE-B"


def clean_sensor_payload(payload: Dict[str, Any]) -> Dict[str, Any]:
    """
    Cleans, casts types, and standardizes field names from ESP32 telemetry.
    Supports both legacy and modern schema formats.
    """
    # Node ID
    node_id = str(payload.get("node_id") or payload.get("sensor_id") or "ESP32-B04").strip().upper()

    # Zone
    zone = standardize_zone(payload.get("zone") or payload.get("zone_id"))

    # Timestamp
    raw_ts = payload.get("timestamp")
    if not raw_ts:
        timestamp = datetime.now().strftime("%I:%M:%S %p")
        created_at_iso = datetime.now().isoformat()
    else:
        timestamp = str(raw_ts)
        created_at_iso = datetime.now().isoformat()

    # Coordinates
    try:
        lat = float(payload.get("latitude", 23.776))
    except (ValueError, TypeError):
        lat = 23.776

    try:
        lon = float(payload.get("longitude", 86.424))
    except (ValueError, TypeError):
        lon = 86.424

    try:
        elevation = float(payload.get("elevation", payload.get("elevation_m", 182.0)))
    except (ValueError, TypeError):
        elevation = 182.0

    # Inclinometer (Tilt)
    def parse_float(val, default=0.0):
        try:
            return float(val) if val is not None else default
        except (ValueError, TypeError):
            return default

    tilt_x = parse_float(payload.get("tilt_x"), 0.0)
    tilt_y = parse_float(payload.get("tilt_y"), 0.0)
    tilt_z = parse_float(payload.get("tilt_z"), 0.0)

    # Vibration
    vib = parse_float(payload.get("vibration"), 0.0)
    vib_1 = parse_float(payload.get("vibration_1", payload.get("vibration_sw1")), vib)
    vib_2 = parse_float(payload.get("vibration_2", payload.get("vibration_sw2")), vib * 0.88)
    vib_3 = parse_float(payload.get("vibration_3", payload.get("vibration_sw3")), vib * 0.35)
    max_vib = max(vib, vib_1, vib_2, vib_3)

    # Displacement (LVDT / Extensometer)
    disp = parse_float(payload.get("displacement", payload.get("displacement_mm")), 0.0)
    disp_rate = parse_float(payload.get("displacement_rate", payload.get("subsidence_rate")), 0.0)

    # Crack status & width
    crack_detected = bool(payload.get("crack_detected", False))
    raw_crack_status = str(payload.get("crack_status", "NONE")).strip().upper()
    crack_width = parse_float(payload.get("crack_width"), 0.0)

    if crack_width > 0.0 and raw_crack_status == "NONE":
        raw_crack_status = "INITIATED"
    elif crack_detected and raw_crack_status == "NONE":
        raw_crack_status = "INITIATED"

    # Climate
    temp = parse_float(payload.get("temperature"), 28.0)
    hum = parse_float(payload.get("humidity"), 65.0)

    # Hardware health
    battery = int(parse_float(payload.get("battery"), 90.0))
    signal = int(parse_float(payload.get("signal_strength", payload.get("rssi")), -60.0))

    return {
        "node_id": node_id,
        "sensor_id": node_id,
        "zone_id": zone,
        "zone": zone,
        "zoneLabel": zone,
        "timestamp": timestamp,
        "created_at_iso": created_at_iso,
        "latitude": lat,
        "longitude": lon,
        "elevation": elevation,
        "tilt_x": round(tilt_x, 2),
        "tilt_y": round(tilt_y, 2),
        "tilt_z": round(tilt_z, 2),
        "tilt": round(math.sqrt(tilt_x**2 + tilt_y**2), 2),
        "vibration": round(max_vib, 2),
        "vibration_1": round(vib_1, 2),
        "vibration_2": round(vib_2, 2),
        "vibration_3": round(vib_3, 2),
        "displacement": round(disp, 2),
        "displacement_mm": round(disp, 2),
        "displacement_rate": round(disp_rate, 3),
        "crack_detected": crack_detected or (raw_crack_status != "NONE"),
        "crack_status": raw_crack_status,
        "crack_width": round(crack_width, 2),
        "temperature": round(temp, 1),
        "humidity": round(hum, 1),
        "battery": max(0, min(100, battery)),
        "signal_strength": signal,
        "online": True
    }


def validate_sensor_ranges(data: Dict[str, Any]) -> Tuple[bool, List[str]]:
    """
    Validates that incoming telemetry falls within physical bounds of underground mine sensors.
    """
    warnings = []

    # Tilt limits
    if abs(data["tilt_x"]) > 90.0 or abs(data["tilt_y"]) > 90.0:
        warnings.append(f"Tilt exceeds realistic physical limit (+/-90°): X={data['tilt_x']}°, Y={data['tilt_y']}°")

    # Vibration limits
    if data["vibration"] < 0 or data["vibration"] > 50.0:
        warnings.append(f"Vibration outside operational accelerometer range (0-50g): {data['vibration']}g")

    # Displacement limits
    if data["displacement"] < 0 or data["displacement"] > 250.0:
        warnings.append(f"Displacement outside LVDT range (0-250mm): {data['displacement']}mm")

    # Temperature limits
    if data["temperature"] < -20.0 or data["temperature"] > 90.0:
        warnings.append(f"Temperature outside underground sensor range (-20 to +90°C): {data['temperature']}°C")

    # Humidity limits
    if data["humidity"] < 0.0 or data["humidity"] > 100.0:
        warnings.append(f"Humidity outside range (0-100%): {data['humidity']}%")

    is_valid = len(warnings) == 0
    return is_valid, warnings


def normalize_sensor_features(data: Dict[str, Any]) -> Dict[str, float]:
    """
    Normalizes sensor features into dimensionless indices [0.0, 1.0] for AI processing.
    """
    # Max operational thresholds for normalization
    VIB_MAX = 10.0   # 10g
    TILT_MAX = 5.0   # 5 degrees
    DISP_MAX = 15.0  # 15 mm
    CRACK_MAX = 5.0  # 5 mm
    TEMP_MAX = 45.0  # 45 °C

    tilt_magnitude = math.sqrt(data["tilt_x"]**2 + data["tilt_y"]**2)

    norm_vib = min(1.0, max(0.0, data["vibration"] / VIB_MAX))
    norm_tilt = min(1.0, max(0.0, tilt_magnitude / TILT_MAX))
    norm_disp = min(1.0, max(0.0, data["displacement"] / DISP_MAX))
    norm_crack = min(1.0, max(0.0, data["crack_width"] / CRACK_MAX))
    norm_temp = min(1.0, max(0.0, max(0.0, data["temperature"] - 20.0) / (TEMP_MAX - 20.0)))

    # Composite physical strain index
    strain_index = round(
        0.35 * norm_disp +
        0.25 * norm_tilt +
        0.25 * norm_vib +
        0.15 * norm_crack,
        4
    )

    return {
        "norm_vibration": round(norm_vib, 4),
        "norm_tilt": round(norm_tilt, 4),
        "norm_displacement": round(norm_disp, 4),
        "norm_crack": round(norm_crack, 4),
        "norm_temperature": round(norm_temp, 4),
        "composite_strain_index": strain_index
    }
