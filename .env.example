# NAHIDA - Mine Subsidence Monitoring & Early-Warning System
# Environment Configuration (.env)

# Database Connection (PostgreSQL / TimescaleDB)
# If PostgreSQL is not running locally, the system automatically falls back to In-Memory Demo mode.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nahida_db
DB_CONNECT_TIMEOUT=2

# Machine Learning
ML_MODEL_PATH=../ml/models/isolation_forest.joblib

# CORS Configuration (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Mock Telemetry Mode (true = generate realistic mock telemetry, false = use real ESP32 sensors)
MOCK_TELEMETRY=true
MOCK_INTERVAL_SECONDS=3.0
